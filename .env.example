# ZERO — example environment (copy to .env and fill in; never commit secrets)
# AITE reads these via os.environ (engine/aite/config.py). Dotenv is optional.

# ── Gemini (optional — AGI / debate work offline without a key) ──────────────
# GEMINI_API_KEY=

# ── ZERO AITE ────────────────────────────────────────────────────────────────
# Paper fund size in INR (default ₹10,00,000)
# ZERO_AITE_PAPER_FUND=1000000

# Target survivor count in the live book (clamped to 10–40)
# ZERO_AITE_TARGET_BOTS=20

# Opt-in MetaTrader 5 paper path (0=local sim only, 1=try MT5 when installed)
# ZERO_AITE_MT5=0

# India broker Market Watch names — must match MT5 exactly (not yfinance).
# ZERO UI label "NIFTY 50" maps through either of these (first set wins):
# ZERO_AITE_MT5_NIFTY=NIFTY
# ZERO_AITE_MT5_NIFTY50=NIFTY50
# ZERO_AITE_MT5_BANKNIFTY=BANKNIFTY
# ZERO_AITE_MT5_SENSEX=SENSEX

# ── Broker live gate (separate from AITE MT5 paper) ──────────────────────────
# ZERO_BROKER_ARMED=0

# ── Hugging Face (optional — higher Hub rate limits for Kronos weights) ──────
# HF_TOKEN=
# HUGGING_FACE_HUB_TOKEN=

# ── Aegis-Quant / OKF embeddings (MiniLM) ────────────────────────────────────
# After `python scripts/warmup_okf_embeddings.py` the MiniLM weights live in
# the local Hugging Face cache. Then you can refuse Hub downloads entirely:
# HF_HUB_OFFLINE=1
# ZERO_OKF_OFFLINE=1
# Either flag is cache-only. If all-MiniLM-L6-v2 is missing, ingest/retrieve
# raise RuntimeError instead of hanging on the network.
# ZERO_OKF_DEVICE=cpu

# ── ZERO Engine v2.0 ─────────────────────────────────────────────────────────
# Local REA checkout used by the MCP reverse-engineering bridge. The bridge
# talks MCP over stdio to `npx rea-agents mcp`; this path is only used to
# report the installed version. Optional.
# ZERO_REA_PATH=/path/to/REA

# Seconds between live quote refreshes in the unified aggregation view.
# ZERO_V2_QUOTE_TTL=60

# Node runtime used for MCP servers (REA needs >= 24.22.1). Point this at a
# portable / side-by-side Node when the machine-wide install is older.
# ZERO_NODE_DIR=C:/Users/<you>/AppData/Local/Programs/node-v24.22.3/node-v24.22.3-win-x64
# ZERO_NODE=C:/path/to/node.exe

# MCP handshake timeout in seconds (clamped 5-300). Raise it if the first
# npx run has to download the package.
# ZERO_MCP_TIMEOUT=60

# ── Backend / Docker ─────────────────────────────────────────────────────────
# DATABASE_URL=sqlite+aiosqlite:////app/db/terminal.db
# REDIS_URL=redis://redis:6379/0
# ZERO_API_KEY=
